# Copy to .env (git-ignored) and fill in. Only needed for the providers named.
# usgs_m2m / usgs_ard: EROS account + M2M application token (ers.cr.usgs.gov)
export USGS_M2M_USERNAME=
export USGS_M2M_TOKEN=
# gee: Earth Engine cloud project (or set provider_options.gee_project in the config)
export GEE_PROJECT=
# aws_earth_search Landsat only (s3://usgs-landsat is Requester Pays)
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
